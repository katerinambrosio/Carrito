<script> 
function enviar(cmd) { 
const btn = event.currentTarget; 
btn.style.transform = 'scale(0.92)'; 
fetch("", { 
method: "POST", 
headers: { "Content-Type": "application/x-www-form-urlencoded" }, 
body: "cmd=" + cmd 
}) 
.then(r => r.text()) 
.then(() => { 
document.getElementById("estado").innerHTML = "✅ Comando enviado: <b 
style='color:#0070f3'>" + cmd + "</b>"; 
setTimeout(() => btn.style.transform = '', 150); 
}) 
.catch(() => { 
document.getElementById("estado").innerHTML = "⚠️ Error de conexión"; 
btn.style.transform = ''; 
}); 
} 
