#include <Servo.h> 
// SENSORES 
const int SENSOR_IZQ=2,SENSOR_CEN=4,SENSOR_DER=7; 
// SERVO 
const int PIN_SERVO=9; 
// RELÉ 
const int PIN_RELE=8; 
// L298N 
const int IN1=3,IN2=10,IN3=11,IN4=12; 
const int ENA=5,ENB=6; 
// CONFIGURACIÓN 
const int VEL_NORMAL=180,VEL_GIRO=150; 
const int POS_CENTRO=90,POS_IZQ=130,POS_DER=50; 
// VARIABLES 
Servo servoManguera; 
bool apagandoFuego=false; 
// REGISTRO SERIAL 
void registrarMovimiento(String movimiento){Serial.println(movimiento);} 
// SETUP 
void setup(){ 
Serial.begin(9600); 
pinMode(SENSOR_IZQ,INPUT); 
pinMode(SENSOR_CEN,INPUT); 
pinMode(SENSOR_DER,INPUT); 
pinMode(PIN_RELE,OUTPUT); 
digitalWrite(PIN_RELE,HIGH); 
pinMode(IN1,OUTPUT); 
pinMode(IN2,OUTPUT); 
pinMode(IN3,OUTPUT); 
pinMode(IN4,OUTPUT); 
pinMode(ENA,OUTPUT); 
pinMode(ENB,OUTPUT); 
servoManguera.attach(PIN_SERVO); 
servoManguera.write(POS_CENTRO); 
pararMotores(); 
delay(1000); 
registrarMovimiento("SISTEMA_INICIADO"); 
} 
// LOOP 
void loop(){ 
revisarFuego(); 
if(apagandoFuego)return; 
while(Serial.available()>0){ 
char cmd=Serial.read(); 
Serial.print("CMD:"); 
Serial.println(cmd); 
procesarComando(cmd); 
} 
} 
// REVISAR FUEGO 
void revisarFuego(){ 
bool fuegoIzq=digitalRead(SENSOR_IZQ)==LOW; 
bool fuegoCen=digitalRead(SENSOR_CEN)==LOW; 
bool fuegoDer=digitalRead(SENSOR_DER)==LOW; 
if(!fuegoIzq&&!fuegoCen&&!fuegoDer){ 
if(apagandoFuego){ 
apagarBomba(); 
servoSuave(POS_CENTRO); 
apagandoFuego=false; 
registrarMovimiento("FUEGO_APAGADO"); 
} 
return; 
} 
apagandoFuego=true; 
pararMotores(); 
encenderBomba(); 
if(fuegoCen){ 
servoSuave(POS_CENTRO); 
registrarMovimiento("FUEGO_CENTRO"); 
}else if(fuegoIzq){ 
servoSuave(POS_IZQ); 
registrarMovimiento("FUEGO_IZQUIERDA"); 
}else if(fuegoDer){ 
servoSuave(POS_DER); 
registrarMovimiento("FUEGO_DERECHA"); 
} 
} 
// COMANDOS 
void procesarComando(char cmd){ 
Serial.print("EJECUTANDO:"); 
Serial.println(cmd); 
switch(cmd){ 
case 'F': moverAdelante(VEL_NORMAL); registrarMovimiento("ADELANTE"); break; 
case 'B': moverAtras(VEL_NORMAL); registrarMovimiento("ATRAS"); break; 
case 'L': girarIzquierda(VEL_GIRO); registrarMovimiento("IZQUIERDA"); break; 
case 'R': girarDerecha(VEL_GIRO); registrarMovimiento("DERECHA"); break; 
case 'S': pararMotores(); registrarMovimiento("STOP"); break; 
case 'C': encenderBomba(); registrarMovimiento("BOMBA_ON"); break; 
case 'X': apagarBomba(); registrarMovimiento("BOMBA_OFF"); break; 
case 'P': 
pararMotores(); 
apagarBomba(); 
servoSuave(POS_CENTRO); 
apagandoFuego=false; 
registrarMovimiento("EMERGENCIA"); 
break; 
} 
} 
// SERVO SUAVE 
void servoSuave(int destino){ 
int actual=servoManguera.read(); 
if(actual<destino){ 
for(int pos=actual;pos<=destino;pos++){ 
servoManguera.write(pos); 
delay(5); 
} 
}else{ 
for(int pos=actual;pos>=destino;pos--){ 
servoManguera.write(pos); 
delay(5); 
} 
} 
} 
// MOTORES 
void moverAdelante(int velocidad){ 
analogWrite(ENA,velocidad); 
analogWrite(ENB,velocidad); 
digitalWrite(IN1,HIGH); 
digitalWrite(IN2,LOW); 
digitalWrite(IN3,HIGH); 
digitalWrite(IN4,LOW); 
} 
void moverAtras(int velocidad){ 
analogWrite(ENA,velocidad); 
analogWrite(ENB,velocidad); 
digitalWrite(IN1,LOW); 
digitalWrite(IN2,HIGH); 
digitalWrite(IN3,LOW); 
digitalWrite(IN4,HIGH); 
} 
void girarDerecha(int velocidad){ 
analogWrite(ENA,velocidad); 
analogWrite(ENB,velocidad); 
digitalWrite(IN1,HIGH); 
digitalWrite(IN2,LOW); 
digitalWrite(IN3,LOW); 
digitalWrite(IN4,HIGH); 
} 
void girarIzquierda(int velocidad){ 
analogWrite(ENA,velocidad); 
analogWrite(ENB,velocidad); 
digitalWrite(IN1,LOW); 
digitalWrite(IN2,HIGH); 
digitalWrite(IN3,HIGH); 
digitalWrite(IN4,LOW); 
} 
void pararMotores(){ 
analogWrite(ENA,0); 
analogWrite(ENB,0); 
digitalWrite(IN1,LOW); 
digitalWrite(IN2,LOW); 
digitalWrite(IN3,LOW); 
digitalWrite(IN4,LOW); 
} 
// BOMBA 
void encenderBomba(){digitalWrite(PIN_RELE,LOW);} 
void apagarBomba(){digitalWrite(PIN_RELE,HIGH);} 
